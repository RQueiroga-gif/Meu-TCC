# Copie para .env (na raiz dfd-assistido/) e ajuste. Nunca versione o .env.

# ----------------------------------------------------------------- aplicação
DEBUG=false
# Gere uma chave própria:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=gere-com-openssl-rand-hex-32
TOKEN_EXPIRA_MINUTOS=480
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15
FUSO_HORARIO=America/Sao_Paulo

# ----------------------------------------------------------------- banco
# sqlite: um arquivo, zero infraestrutura (padrão de desenvolvimento)
# mysql : quando houver mais de um processo escrevendo (ex.: com n8n)
DB_DIALETO=sqlite
# --- MySQL (usados apenas quando DB_DIALETO=mysql)
DB_HOST=localhost
DB_PORTA=3306
DB_NOME=dfd
DB_USUARIO=dfd
DB_SENHA=troque-esta-senha

# ----------------------------------------------------------------- recuperação
# Gerador de embeddings (todos rodam localmente):
#   BAAI/bge-m3            referência do TCC; exige "pip install sentence-transformers"
#                          (baixa ~2 GB na 1ª vez)
#   spacy:pt_core_news_md  semântico leve (~40 MB); exige spaCy + modelo pt_core_news_md
#   hash                   determinístico, sem semântica (testes)
# Sem a biblioteca do gerador escolhido, o sistema cai no "hash". Ao trocar de
# gerador, reconstrua o índice:  python -m scripts.seed --reindexar
EMBEDDING_MODELO=BAAI/bge-m3
INDICE_BACKEND=numpy
# Modo de recuperação: automatico (híbrido BGE-M3 + BM25 com BGE-M3; BM25 sem ele),
# denso, lexical ou hibrido. Ver capítulo 5 (experimento E1).
RECUPERACAO_MODO=automatico
RECUPERACAO_TOP_K=6
# Limiares do portão de suficiência, um por gerador (calibrados no experimento E3).
RECUPERACAO_LIMIAR=0.52
RECUPERACAO_LIMIAR_SPACY=0.64
RECUPERACAO_LIMIAR_HASH=0.46

# ----------------------------------------------------------------- dados pessoais
# Reconhecimento de nomes de pessoas (spaCy) na minimização (RN06).
ANONIMIZADOR_NER=true
ANONIMIZADOR_MODELO_NER=pt_core_news_md

# ----------------------------------------------------------------- modelo de linguagem
# anthropic | gemini | groq | ollama | echo (determinístico, sem rede — para desenvolvimento)
LLM_PROVEDOR=echo
# Revisão de texto (botão "Revisar texto"); vazio = o mesmo de LLM_PROVEDOR.
# Prefira um fornecedor diferente do gerador, para o modelo não revisar a si mesmo.
LLM_PROVEDOR_CORRECAO=
# Modelo da revisão; vazio = o padrão do provedor. No Gemini gratuito a cota diária
# é por modelo: um "flash-lite" aqui preserva a cota do GEMINI_MODELO (E9).
LLM_MODELO_CORRECAO=
LLM_MODELO=claude-haiku-4-5-20251001
LLM_TEMPERATURA=0.0
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_S=120
LLM_TENTATIVAS=3
ANTHROPIC_API_KEY=
# Gemini (chave em aistudio.google.com). No nível gratuito o Google pode usar o
# conteúdo enviado para melhorar seus produtos: use só com demandas fictícias.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.6-flash
# Raciocínio interno do Gemini 3: low | medium | high (vazio = padrão do modelo)
GEMINI_NIVEL_RACIOCINIO=low
# Groq (chave em console.groq.com): modelos abertos, nível gratuito com limite por
# minuto e por dia. Confira a política de dados antes de enviar demandas reais.
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-120b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.1:8b
